<?php

declare(strict_types=1);

namespace Pdo;

/**
 * PHP 8.4+ PDO SQLite driver subclass, modelled for PHPStan runs on older runtimes.
 * Analysis only: it is never autoloaded, so `class_exists('Pdo\\Sqlite')` stays false on PHP 8.2/8.3.
 *
 * @see https://www.php.net/manual/en/class.pdo-sqlite.php
 */
class Sqlite extends \PDO
{
    public const ATTR_OPEN_FLAGS = 0;

    public const OPEN_READONLY = 0;
}

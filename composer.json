{
  "name": "voku/agent-graph",
  "description": "Deterministic SQLite graph indexing and shared SQLite runtime support for coding-agent tooling.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/voku/agent-graph",
  "support": {
    "issues": "https://github.com/voku/agent-graph/issues",
    "source": "https://github.com/voku/agent-graph"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "graph",
    "sqlite",
    "sqlite-vec"
  ],
  "authors": [
    {
      "name": "Lars Moelleken",
      "homepage": "https://github.com/voku"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "voku\\AgentGraph\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "voku\\AgentGraph\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
    "ci": [
      "@composer validate --strict",
      "@test",
      "@phpstan"
    ]
  }
}
